# =============================================================================
# Bundled stack (.env.docker) — copy to .env.docker and edit before deploy
#   cp .env.docker.example .env.docker
# =============================================================================

# --- Bundled SQL Server (docker compose `sqlserver` service) ---
# SA password: 8+ chars, upper + lower + digit + symbol. Must match OPT_DB_PASSWORD.
MSSQL_SA_PASSWORD=ChangeMe!Str0ng#Pass
OPT_DB_SERVER=sqlserver
OPT_DB_NAME=OptionsAdvisorDB
OPT_DB_USER=sa
OPT_DB_PASSWORD=ChangeMe!Str0ng#Pass
OPT_DB_TIMEOUT=30
OPT_DB_CREATE_IF_MISSING=true

# --- Windows laptop with local SQLEXPRESS (skip bundled sqlserver service) ---
# OPT_DB_SERVER=host.docker.internal\SQLEXPRESS
# OPT_DB_USER=
# OPT_DB_PASSWORD=
# Then: docker compose up -d options_advisor ws_runner

# --- Dashboard ---
OPT_DASHBOARD_HOST=0.0.0.0
OPT_DASHBOARD_PORT=5001
OPT_DASHBOARD_DEBUG=false

# --- Logging ---
OPT_LOG_CONSOLE_LEVEL=INFO
OPT_LOG_FILE_LEVEL=INFO
OPT_LOG_DB_LEVEL=INFO
OPT_LOG_DIR=logs

# --- Zerodha (live data + WS runner) ---
OPT_PROVIDERS=zerodha
OPT_ZERODHA_ENABLED=true
OPT_ZERODHA_API_KEY=
OPT_ZERODHA_API_SECRET=

# --- Email alerts (optional) ---
OPT_EMAIL_ENABLED=false
OPT_SMTP_HOST=
OPT_SMTP_PORT=587
OPT_SMTP_USER=
OPT_SMTP_PASSWORD=
OPT_SMTP_FROM=
OPT_SMTP_TO=
OPT_SMTP_USE_TLS=true

# Trading Economics API — optional calendar feed
OPT_TE_API_KEY=
