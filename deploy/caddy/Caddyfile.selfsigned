# Self-signed HTTPS — no domain required (cert generated by enable-https.sh).
# Browser shows a warning once: Advanced → Proceed / Continue to site.
# Access: https://<VmPublicIP>/

{
	auto_https off
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
	encode gzip
	reverse_proxy options_advisor:5001
}
